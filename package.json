{
  "name": "mygpt",
  "productName": "MyGPT",
  "version": "2.0.0",
  "description": "Standalone ChatGPT desktop client - Denys Oleksiienko style 22-07-2026 ",
  "main": "main.js",
  "type": "commonjs",
  "author": "Denys Oleksiienko",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.denysoleksiienko.mygpt",
    "productName": "MyGPT",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "MyGPT.icns"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}