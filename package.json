{
  "name": "mygpt-electron",
  "productName": "MyGPT — Electron",
  "version": "2.11.0",
  "description": "MyGPT desktop app for macOS: ChatGPT window with working Google sign-in, link copying and pure black theme",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "smoke": "MYGPT_SMOKE=1 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.denysoleksiienko.mygpt",
    "productName": "MyGPT — Electron",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "MyGPT.icns",
      "extendInfo": {
        "CFBundleName": "MyGPT — Electron",
        "CFBundleDisplayName": "MyGPT — Electron",
        "CFBundleShortVersionString": "2.11.0",
        "CFBundleVersion": "2.11.0"
      }
    },
    "dmg": {
      "icon": "MyGPT.icns",
      "title": "MyGPT — Electron 2.11.0"
    },
    "files": [
      "main.js",
      "MyGPT.icns",
      "about-icon.png",
      "package.json",
      "!dist",
      "!node_modules/.cache"
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
